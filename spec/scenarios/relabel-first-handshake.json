{
  "name": "relabel-first-handshake",
  "description": "Discord rewrites the Companion user's first handshake as a Duhcord one. Duhcord trusts it on first use as a Duhcord key, so the two safety numbers differ: the relabelling shows up when they compare.",
  "devices": {
    "alice-mac": { "person": "alice", "client": "duhcord" },
    "bob-pc": { "person": "bob", "client": "companion", "host": "replugged" }
  },
  "steps": [
    { "do": "setPrivate", "device": "alice-mac", "on": true },
    { "do": "deliver" },
    { "do": "setPrivate", "device": "bob-pc", "on": true },
    { "do": "relabel", "device": "bob-pc", "client": 0 },
    { "do": "deliver" },
    { "expect": { "alice-mac": { "state": "ready", "keys": { "bob-pc": "accepted" }, "newKey": false } } },
    { "do": "deliver" },
    { "expect": {
        "bob-pc": { "state": "ready" },
        "alice-mac": { "safetyNumber": { "differs-from": "bob-pc" } }
    } }
  ]
}
