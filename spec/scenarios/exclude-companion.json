{
  "name": "exclude-companion",
  "description": "Alice excludes bob's Companion keys for this chat: he becomes unconfirmed and her safety number drops his key; turning the exclusion off makes both ready again.",
  "devices": {
    "alice-mac": { "person": "alice", "client": "duhcord" },
    "bob-pc": { "person": "bob", "client": "companion", "host": "vesktop" }
  },
  "steps": [
    { "do": "setPrivate", "device": "alice-mac", "on": true },
    { "do": "deliver" },
    { "do": "setPrivate", "device": "bob-pc", "on": true },
    { "do": "deliver" },
    { "do": "accept", "device": "alice-mac", "keys": ["bob-pc"] },
    { "do": "deliver" },
    { "expect": { "alice-mac": { "state": "ready" }, "bob-pc": { "state": "ready" } } },
    { "do": "excludeCompanion", "device": "alice-mac", "on": true },
    { "expect": {
        "alice-mac": { "state": "waiting", "keys": { "bob-pc": "excluded" }, "safetyNumber": { "none": "" },
                       "outbox": [ { "handshake": { "wantsReply": false, "acceptedKeys": [] } } ] }
    } },
    { "do": "deliver" },
    { "expect": { "bob-pc": { "state": "unconfirmed", "hasOurKey": false } } },
    { "do": "excludeCompanion", "device": "alice-mac", "on": false },
    { "do": "deliver" },
    { "expect": {
        "alice-mac": { "state": "ready", "keys": { "bob-pc": "accepted" }, "safetyNumber": { "same-as": "bob-pc" } },
        "bob-pc": { "state": "ready" }
    } }
  ]
}
